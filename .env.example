WATER_AGENT_QWEN_BASE_URL=https://www.zsjsry.top/v1
WATER_AGENT_QWEN_MODEL=qwen3.6-27b
# 二选一：推荐使用环境变量；也可配置赛事方提供的本地密钥文件。
WATER_AGENT_QWEN_API_KEY=
WATER_AGENT_QWEN_API_KEY_FILE=
WATER_AGENT_QWEN_TIMEOUT_SECONDS=30
WATER_AGENT_QWEN_MAX_RETRIES=1
WATER_AGENT_QWEN_MAX_PROMPT_CHARS=2000
WATER_AGENT_QWEN_MAX_TOKENS=192
# 短解释任务默认关闭思考模式，降低空响应与超时风险。
WATER_AGENT_QWEN_ENABLE_THINKING=false
WATER_AGENT_MODEL_WEIGHTS=artifacts/models/best.pt
# 正式四折集成时填写JSON数组；非空时优先于单模型MODEL_WEIGHTS。
WATER_AGENT_ENSEMBLE_WEIGHTS=[]
# OOF温度缩放未改善ECE/Brier，首版保持1.0。
WATER_AGENT_ENSEMBLE_TEMPERATURE=1.0
WATER_AGENT_VISION_IMAGE_SIZE=320
WATER_AGENT_VISION_DEVICE=0
WATER_AGENT_REVIEW_THRESHOLD=0.65
# 当前模型对“乱建/正常”的OOF证据不足，交互端强制建议复核。
WATER_AGENT_FORCE_REVIEW_LABELS=["乱建","正常"]
WATER_AGENT_ENABLE_AUDIT_LOG=true
WATER_AGENT_AUDIT_DB_PATH=artifacts/logs/agent_audit.sqlite3
WATER_AGENT_USE_FAKE_MODEL=true
WATER_AGENT_USE_QWEN=false
